# ---------------------------------------------------------------------------
# Eastbridge Quiz Arcade — environment variables
# Copy to `.env` and fill in. Leave both Supabase values blank to run the
# fully-featured local demo (data stays in this browser's localStorage).
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefghijkl.supabase.co
VITE_SUPABASE_URL=

# Supabase anon (public) key. Safe to expose: row-level security protects data.
VITE_SUPABASE_ANON_KEY=

# Optional: canonical public URL used in the join QR code and share links,
# e.g. https://quiz.eastbridge.edu.gh. Defaults to window.location.origin.
VITE_PUBLIC_APP_URL=
